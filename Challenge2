    "    legend=[\"P(1) = 20%\", \"P(1) = 50%\", \"P(1) = 80%\"],\n",
    "    title=\"Biased Qubit Measurement Results (100 Shots)\"\n",
    ")\n",
    "\n",
    "plt.show()\n"
   ]
